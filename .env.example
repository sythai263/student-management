# ---- Supabase ----
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# ---- S3-Compatible Storage ----
# Local: MinIO at http://localhost:9000 | Production: Cloudflare R2
S3_ENDPOINT=http://localhost:9000
S3_REGION=auto
S3_ACCESS_KEY_ID=minioadmin
S3_SECRET_ACCESS_KEY=minioadmin
S3_BUCKET=student-management
S3_FORCE_PATH_STYLE=true
# Public base URL used to build avatarUrl / imageUrls (no trailing slash)
S3_PUBLIC_BASE_URL=http://localhost:9000/student-management
# Cloudflare R2 public hostname for next/image (production only)
R2_PUBLIC_HOSTNAME=

# ---- AWS Rekognition ----
AWS_REGION=ap-southeast-1
AWS_ACCESS_KEY_ID=your-aws-access-key
AWS_SECRET_ACCESS_KEY=your-aws-secret-key
